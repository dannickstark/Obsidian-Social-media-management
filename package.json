{
  "name": "osmm-social-planner",
  "version": "0.1.0",
  "description": "Plan, preview, schedule and publish social media posts from Obsidian.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "moment": "^2.31.0",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.9",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
